{
  "name": "flores-tools",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.mts\" \"scripts/**/*.test.mts\"",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "shots": "tsx scripts/screenshot.mts",
    "smoke": "tsx scripts/smoke.mts",
    "e2e": "tsx scripts/e2e.mts"
  },
  "dependencies": {
    "imapflow": "2.5.4",
    "lucide-react": "1.22.0",
    "mailparser": "3.9.45",
    "next": "16.3.8",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mailparser": "3.9.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "playwright-core": "1.63.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "^5"
  }
}
